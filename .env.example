# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - FIRMEZA ERP & PORTAL WEB
# ==============================================================================

# Entorno de ejecución
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8888
CLIENT_PORT=8889

# Base de datos PostgreSQL
POSTGRES_DB=firmeza
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_here
POSTGRES_PORT=5433

# Cadena de conexión para la API
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=firmeza;Username=postgres;Password=postgres_secure_password_here

# Cuenta Administrador Inicial (Seed)
SeedAdmin__Email=admin@firmeza.local
SeedAdmin__Password=AdminSeguro2026!

# Configuración JWT (Seguridad de Tokens)
Jwt__Issuer=Firmeza.Api
Jwt__Audience=Firmeza.Client
# La clave secreta debe ser de al menos 32 caracteres (256 bits)
Jwt__SigningKey=clave-super-secreta-de-produccion-firmeza-erp-2026-32b
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7

# Base de datos y Migraciones
Database__MigrateOnStartup=true
Swagger__Enabled=true

# Política CORS (Orígenes autorizados)
CORS_CLIENT_ORIGIN=http://firmeza.clandev.com
Cors__AllowedOrigins__0=http://firmeza.clandev.com
Cors__AllowedOrigins__1=https://firmeza.clandev.com
Cors__AllowedOrigins__2=http://services.firmeza.clandev.com
Cors__AllowedOrigins__3=https://services.firmeza.clandev.com
Cors__AllowedOrigins__4=http://localhost:8889
Cors__AllowedOrigins__5=http://localhost:4200

# ==============================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (SMTP / SENDGRID)
# ==============================================================================
# Proveedor: "Smtp" o "SendGrid"
Mail__Provider=Smtp
Mail__Enabled=true

# Servidor SMTP (ejemplo: smtp.gmail.com, smtp.sendgrid.net, mailhog, etc.)
Mail__Host=smtp.gmail.com
Mail__Port=587
Mail__EnableSsl=true

# Credenciales SMTP (para Gmail, use contraseña de aplicación generada en seguridad de Google)
Mail__UserName=ventas@firmeza.com
Mail__Password=tu_contraseña_de_aplicacion_aqui

# Remitente visible en los correos
Mail__FromEmail=ventas@firmeza.com
Mail__FromName=Firmeza Materiales de Construcción

# Opcional: Clave API si Mail__Provider es "SendGrid"
Mail__SendGridApiKey=SG.ejemplo_de_api_key_sendgrid

# ==============================================================================
# AUTENTICACIÓN EXTERNA OAUTH (GITHUB)
# ==============================================================================
Authentication__GitHub__ClientId=tu_github_client_id_aqui
Authentication__GitHub__ClientSecret=tu_github_client_secret_aqui
