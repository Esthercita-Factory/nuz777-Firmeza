# Imagen de pruebas: compila Firmeza.Tests y ejecuta dotnet test.
# Si alguna prueba falla el contenedor sale con codigo distinto de 0, y eso es
# lo que hace que docker compose no levante api ni web.
#
#   docker build -f Dockerfile.tests -t firmeza-tests .
#   docker run --rm firmeza-tests
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Primero solo los .csproj: asi la capa de restore se cachea y no se
# invalida cada vez que cambia un archivo de codigo.
COPY Firmeza.sln ./
COPY API/src/Firmeza.Domain/Firmeza.Domain.csproj API/src/Firmeza.Domain/
COPY API/src/Firmeza.Application/Firmeza.Application.csproj API/src/Firmeza.Application/
COPY API/src/Firmeza.Infrastructure/Firmeza.Infrastructure.csproj API/src/Firmeza.Infrastructure/
COPY API/src/Firmeza.Api/Firmeza.Api.csproj API/src/Firmeza.Api/
COPY API/src/Firmeza.Tests/Firmeza.Tests.csproj API/src/Firmeza.Tests/
RUN dotnet restore API/src/Firmeza.Tests/Firmeza.Tests.csproj

COPY API/src/Firmeza.Domain/ API/src/Firmeza.Domain/
COPY API/src/Firmeza.Application/ API/src/Firmeza.Application/
COPY API/src/Firmeza.Infrastructure/ API/src/Firmeza.Infrastructure/
COPY API/src/Firmeza.Api/ API/src/Firmeza.Api/
COPY API/src/Firmeza.Tests/ API/src/Firmeza.Tests/

RUN dotnet build API/src/Firmeza.Tests/Firmeza.Tests.csproj -c Release --no-restore

# dotnet test devuelve != 0 si alguna prueba falla, que es lo que hace que
# docker compose no levante el resto de los servicios.
ENTRYPOINT ["dotnet", "test", "API/src/Firmeza.Tests/Firmeza.Tests.csproj", "-c", "Release", "--no-build", "--logger", "console;verbosity=normal"]