FROM node:22-alpine AS frontend
WORKDIR /src/client

COPY client/package*.json ./
RUN npm ci

COPY client/ ./
# El build publica el bundle en API/src/Firmeza.Web/wwwroot.
RUN npm run build:publish

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

COPY API/src/Firmeza.Web/Firmeza.Web.csproj API/src/Firmeza.Web/
RUN dotnet restore API/src/Firmeza.Web/Firmeza.Web.csproj

COPY API/src/Firmeza.Web/ API/src/Firmeza.Web/
COPY --from=frontend /src/API/src/Firmeza.Web/wwwroot API/src/Firmeza.Web/wwwroot
RUN dotnet publish API/src/Firmeza.Web/Firmeza.Web.csproj -c Release -o /app/publish /p:UseAppHost=false /p:SkipFrontendBuild=true

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Firmeza.Web.dll"]
