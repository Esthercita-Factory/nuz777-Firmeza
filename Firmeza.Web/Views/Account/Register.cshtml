@model RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}
<div class="mx-auto max-w-lg rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-200 sm:p-12"><p class="text-sm font-black uppercase tracking-[0.25em] text-amber-600">Portal de clientes</p><h1 class="mt-3 text-3xl font-black text-slate-950">Crea tu cuenta</h1><p class="mt-2 text-sm text-slate-500">Esta cuenta es para el portal de clientes, no para el panel administrativo.</p>
    <form asp-action="Register" method="post" class="mt-8 space-y-5"><div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>
        <div><label asp-for="FullName" class="mb-2 block text-sm font-bold text-slate-700"></label><input asp-for="FullName" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100" /><span asp-validation-for="FullName" class="text-xs text-rose-600"></span></div>
        <div><label asp-for="Email" class="mb-2 block text-sm font-bold text-slate-700"></label><input asp-for="Email" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100" /><span asp-validation-for="Email" class="text-xs text-rose-600"></span></div>
        <div><label asp-for="Password" class="mb-2 block text-sm font-bold text-slate-700"></label><input asp-for="Password" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100" /><span asp-validation-for="Password" class="text-xs text-rose-600"></span></div>
        <div><label asp-for="ConfirmPassword" class="mb-2 block text-sm font-bold text-slate-700"></label><input asp-for="ConfirmPassword" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100" /><span asp-validation-for="ConfirmPassword" class="text-xs text-rose-600"></span></div>
        <button class="w-full rounded-xl bg-slate-950 px-5 py-3 font-black text-white transition hover:bg-amber-400 hover:text-slate-950" type="submit">Crear cuenta</button>
    </form><p class="mt-6 text-center text-sm text-slate-500">¿Ya tienes cuenta? <a asp-action="Login" class="font-bold text-amber-600">Ingresar</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
