@model CustomerFormViewModel
@{ ViewData["Title"] = "Editar cliente"; }
<div class="mx-auto max-w-3xl"><a asp-action="Index" class="text-sm font-bold text-amber-600">← Volver a clientes</a><div class="mt-5 rounded-3xl bg-white p-8 shadow-sm sm:p-10"><p class="text-sm font-black uppercase tracking-[0.2em] text-amber-600">Relaciones</p><h1 class="mt-2 text-3xl font-black">Editar cliente</h1><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-8"><div asp-validation-summary="ModelOnly" class="mb-5 text-sm text-rose-600"></div><input asp-for="Id" type="hidden" /><partial name="_Form" model="Model" /><div class="mt-8 flex justify-end gap-3"><a asp-action="Index" class="rounded-xl border border-slate-300 px-5 py-3 text-sm font-bold text-slate-700">Cancelar</a><button type="submit" class="rounded-xl bg-amber-400 px-6 py-3 text-sm font-black text-slate-950">Guardar cambios</button></div></form></div></div>

