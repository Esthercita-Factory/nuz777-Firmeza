@model IEnumerable<CustomerListItemViewModel>
@{ ViewData["Title"] = "Clientes"; var soloActivos = ViewData["SoloActivos"] is true; var query = ViewData["Query"] as string; }
<div class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-black uppercase tracking-[0.2em] text-amber-600">Relaciones</p><h1 class="mt-2 text-3xl font-black tracking-tight">Clientes</h1><p class="mt-2 text-slate-500">Información de las personas y negocios que confían en Firmeza.</p></div><a asp-action="Create" class="rounded-xl bg-amber-400 px-5 py-3 text-sm font-black text-slate-950 shadow-lg shadow-amber-100 transition hover:bg-amber-300">+ Nuevo cliente</a></div>
<form method="get" class="mt-8 flex flex-wrap gap-3"><input name="q" value="@query" placeholder="Buscar por nombre, documento o correo..." class="min-w-[260px] flex-1 rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100" /><button class="rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">Buscar</button><a asp-action="Index" asp-route-soloActivos="@(!soloActivos)" class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700">@(soloActivos ? "Ver todos" : "Solo activos")</a></form>
<div class="mt-6 overflow-hidden rounded-2xl bg-white shadow-sm"><div class="overflow-x-auto"><table class="w-full min-w-[850px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500"><tr><th class="px-6 py-4">Cliente</th><th class="px-6 py-4">Documento</th><th class="px-6 py-4">Contacto</th><th class="px-6 py-4">Edad</th><th class="px-6 py-4">Estado</th><th class="px-6 py-4 text-right">Acciones</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach (var customer in Model) {<tr class="@(customer.IsActive ? "" : "bg-slate-50 text-slate-400") hover:bg-amber-50/40"><td class="px-6 py-4"><p class="font-bold text-slate-900">@customer.FullName</p><p class="text-xs text-slate-500">@customer.Email</p></td><td class="px-6 py-4 font-mono text-xs text-slate-600">@customer.Document</td><td class="px-6 py-4 text-slate-600">@customer.Phone</td><td class="px-6 py-4">@customer.Age años</td><td class="px-6 py-4"><span class="rounded-full px-3 py-1 text-xs font-bold @(customer.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-500")">@(customer.IsActive ? "Activo" : "Inactivo")</span></td><td class="px-6 py-4 text-right"><a asp-action="Edit" asp-route-id="@customer.Id" class="font-bold text-amber-600 hover:text-amber-500">Editar</a><form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="ml-3 inline" onsubmit="return confirm('¿Eliminar este cliente?');"><button class="font-bold text-rose-500 hover:text-rose-700">Eliminar</button></form></td></tr>}@if (!Model.Any()) {<tr><td colspan="6" class="px-6 py-14 text-center text-slate-500">No hay clientes que coincidan con la búsqueda.</td></tr>}</tbody></table></div></div>
