@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-black uppercase tracking-[0.2em] text-amber-600">Resumen operativo</p><h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Buenos días, @User.Identity?.Name?.Split('@')[0]</h1><p class="mt-2 text-slate-500">Esto es lo que está pasando en tu negocio.</p></div><span class="rounded-full bg-white px-4 py-2 text-xs font-bold text-slate-500 shadow-sm">Panel administrativo</span></div>
<div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><div class="rounded-2xl bg-slate-950 p-6 text-white shadow-lg shadow-slate-200"><p class="text-sm text-slate-400">Productos activos</p><p class="mt-3 text-4xl font-black">@Model.ProductCount</p><a asp-controller="Products" asp-action="Index" class="mt-5 inline-block text-xs font-bold text-amber-400">Ver catálogo →</a></div><div class="rounded-2xl bg-white p-6 shadow-sm"><p class="text-sm text-slate-500">Clientes activos</p><p class="mt-3 text-4xl font-black text-slate-950">@Model.CustomerCount</p><a asp-controller="Customers" asp-action="Index" class="mt-5 inline-block text-xs font-bold text-amber-600">Ver clientes →</a></div><div class="rounded-2xl bg-white p-6 shadow-sm"><p class="text-sm text-slate-500">Ventas registradas</p><p class="mt-3 text-4xl font-black text-slate-950">@Model.SaleCount</p><a asp-controller="Sales" asp-action="Index" class="mt-5 inline-block text-xs font-bold text-amber-600">Ver ventas →</a></div><div class="rounded-2xl border border-amber-200 bg-amber-50 p-6"><p class="text-sm text-amber-800">Ventas acumuladas</p><p class="mt-3 text-3xl font-black text-slate-950">@Model.SalesTotal.ToString("C2")</p><p class="mt-5 text-xs font-semibold text-amber-700">Sin ventas canceladas</p></div></div>
<div class="mt-8 rounded-2xl bg-white shadow-sm"><div class="flex items-center justify-between border-b border-slate-100 px-6 py-5"><div><h2 class="font-black text-slate-950">Ventas recientes</h2><p class="mt-1 text-sm text-slate-500">Últimos movimientos registrados.</p></div><a asp-controller="Sales" asp-action="Index" class="text-sm font-bold text-amber-600">Ver todas</a></div><div class="overflow-x-auto"><table class="w-full min-w-[650px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500"><tr><th class="px-6 py-4">Venta</th><th class="px-6 py-4">Cliente</th><th class="px-6 py-4">Fecha</th><th class="px-6 py-4">Estado</th><th class="px-6 py-4 text-right">Total</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach (var sale in Model.RecentSales) {<tr class="hover:bg-slate-50"><td class="px-6 py-4 font-bold text-slate-900">@sale.SaleNumber</td><td class="px-6 py-4 text-slate-600">@sale.CustomerName</td><td class="px-6 py-4 text-slate-500">@sale.SaleDate.ToLocalTime().ToString("dd/MM/yyyy")</td><td class="px-6 py-4"><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">@sale.Status</span></td><td class="px-6 py-4 text-right font-bold">@sale.Total.ToString("C2")</td></tr>}@if (!Model.RecentSales.Any()) {<tr><td colspan="5" class="px-6 py-12 text-center text-slate-500">Todavía no hay ventas registradas.</td></tr>}</tbody></table></div></div>
