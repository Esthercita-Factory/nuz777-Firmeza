@model IEnumerable<ProductListItemViewModel>
@{ ViewData["Title"] = "Productos"; var soloActivos = ViewData["SoloActivos"] is true; var query = ViewData["Query"] as string; }
<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <p class="text-sm font-black uppercase tracking-[0.2em] text-blue-600">Catálogo</p>
        <h1 class="mt-2 text-3xl font-black tracking-tight">Productos</h1>
        <p class="mt-2 text-slate-500">Materiales disponibles para tu operación.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <a asp-action="ExportExcel" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-sm transition hover:border-emerald-500 hover:text-emerald-600">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 text-emerald-600"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
            Exportar Excel
        </a>
        <a asp-action="ExportPdf" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-sm transition hover:border-rose-500 hover:text-rose-600">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 text-rose-600"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
            Exportar PDF
        </a>
        <a asp-action="Create" class="rounded-xl bg-blue-400 px-5 py-2.5 text-sm font-black text-slate-950 shadow-lg shadow-blue-100 transition hover:bg-blue-300">+ Nuevo producto</a>
    </div>
</div>
<form method="get" class="mt-8 flex flex-wrap gap-3"><input name="q" value="@query" placeholder="Buscar por código, nombre o categoría..." class="min-w-[260px] flex-1 rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-blue-400 focus:ring-4 focus:ring-blue-100" /><button class="rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">Buscar</button><a asp-action="Index" asp-route-soloActivos="@(!soloActivos)" class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700">@(soloActivos ? "Ver todos" : "Solo activos")</a></form>
<div class="mt-6 overflow-hidden rounded-2xl bg-white shadow-sm"><div class="overflow-x-auto"><table class="w-full min-w-[850px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500"><tr><th class="px-6 py-4">Código</th><th class="px-6 py-4">Producto</th><th class="px-6 py-4">Categoría</th><th class="px-6 py-4 text-right">Precio</th><th class="px-6 py-4 text-right">Stock</th><th class="px-6 py-4">Estado</th><th class="px-6 py-4 text-right">Acciones</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach (var product in Model) {<tr class="@(product.IsActive ? "" : "bg-slate-50 text-slate-400") hover:bg-blue-50/40"><td class="px-6 py-4 font-mono text-xs font-bold text-blue-700">@product.Sku</td><td class="px-6 py-4"><p class="font-bold text-slate-900">@product.Name</p><p class="text-xs text-slate-500">Por @product.Unit</p></td><td class="px-6 py-4 text-slate-600">@product.Category</td><td class="px-6 py-4 text-right font-bold">@product.Price.ToString("C2")</td><td class="px-6 py-4 text-right"><span class="font-bold @(product.Stock < 10 ? "text-rose-600" : "text-slate-900")">@product.Stock</span></td><td class="px-6 py-4"><span class="rounded-full px-3 py-1 text-xs font-bold @(product.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-500")">@(product.IsActive ? "Activo" : "Inactivo")</span></td><td class="px-6 py-4 text-right"><a asp-action="Edit" asp-route-id="@product.Id" class="font-bold text-blue-600 hover:text-blue-500">Editar</a><form asp-action="Delete" asp-route-id="@product.Id" method="post" class="ml-3 inline" onsubmit="event.preventDefault(); Swal.fire({ title: '¿Eliminar este producto?', showCancelButton: true, confirmButtonColor: '#3085d6', cancelButtonColor: '#d33', confirmButtonText: 'Sí', cancelButtonText: 'No' }).then((result) => { if (result.isConfirmed) { this.submit(); } });"><button class="font-bold text-rose-500 hover:text-rose-700">Eliminar</button></form></td></tr>}@if (!Model.Any()) {<tr><td colspan="7" class="px-6 py-14 text-center text-slate-500">No hay productos que coincidan con la búsqueda.</td></tr>}</tbody></table></div></div>
