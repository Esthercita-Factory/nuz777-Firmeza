@model ProductFormViewModel
<div class="grid gap-5 sm:grid-cols-2"><div><label asp-for="Sku" class="mb-2 block text-sm font-bold text-slate-700"></label><input asp-for="Sku" class="w-full rounded-xl border border-slate-300 px-4 py-3 uppercase outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100" /><span asp-validation-for="Sku" class="text-xs text-rose-600"></span></div><div><label asp-for="Name" class="mb-2 block text-sm font-bold text-slate-700"></label><input asp-for="Name" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100" /><span asp-validation-for="Name" class="text-xs text-rose-600"></span></div><div><label asp-for="Category" class="mb-2 block text-sm font-bold text-slate-700"></label><input asp-for="Category" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100" /><span asp-validation-for="Category" class="text-xs text-rose-600"></span></div><div><label asp-for="Unit" class="mb-2 block text-sm font-bold text-slate-700"></label><input asp-for="Unit" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100" /><span asp-validation-for="Unit" class="text-xs text-rose-600"></span></div><div><label asp-for="Price" class="mb-2 block text-sm font-bold text-slate-700"></label><input asp-for="Price" type="number" step="0.01" min="0.01" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100" /><span asp-validation-for="Price" class="text-xs text-rose-600"></span></div><div><label asp-for="Stock" class="mb-2 block text-sm font-bold text-slate-700"></label><input asp-for="Stock" type="number" min="0" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100" /><span asp-validation-for="Stock" class="text-xs text-rose-600"></span></div><div class="sm:col-span-2"><label asp-for="Description" class="mb-2 block text-sm font-bold text-slate-700"></label><textarea asp-for="Description" rows="4" class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-amber-400 focus:ring-4 focus:ring-amber-100"></textarea><span asp-validation-for="Description" class="text-xs text-rose-600"></span></div><label class="flex items-center gap-3 text-sm font-bold text-slate-700 sm:col-span-2"><input asp-for="IsActive" class="h-5 w-5 rounded border-slate-300 text-amber-500" /> Producto activo</label></div>
