@model ProductFormViewModel
<div class="grid gap-6 sm:grid-cols-2">
    <div class="space-y-1.5">
        <label asp-for="Sku" class="block text-sm font-bold text-slate-700"></label>
        <input asp-for="Sku" placeholder="Ej.: CEM-001" class="w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm uppercase text-slate-900 placeholder-slate-400 outline-none transition focus:border-amber-400 focus:bg-white focus:ring-4 focus:ring-amber-100" />
        <p class="text-xs text-slate-400">Código único interno para identificar el material, no se puede repetir.</p>
        <span asp-validation-for="Sku" class="block text-xs text-rose-600"></span>
    </div>
    <div class="space-y-1.5">
        <label asp-for="Name" class="block text-sm font-bold text-slate-700"></label>
        <input asp-for="Name" placeholder="Ej.: Cemento Portland 42.5 kg" class="w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 outline-none transition focus:border-amber-400 focus:bg-white focus:ring-4 focus:ring-amber-100" />
        <span asp-validation-for="Name" class="block text-xs text-rose-600"></span>
    </div>
    <div class="space-y-1.5">
        <label asp-for="Category" class="block text-sm font-bold text-slate-700"></label>
        <input asp-for="Category" placeholder="Ej.: Cementos" class="w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 outline-none transition focus:border-amber-400 focus:bg-white focus:ring-4 focus:ring-amber-100" />
        <span asp-validation-for="Category" class="block text-xs text-rose-600"></span>
    </div>
    <div class="space-y-1.5">
        <label asp-for="Unit" class="block text-sm font-bold text-slate-700"></label>
        <input asp-for="Unit" placeholder="Ej.: Saco, Unidad, Metro" class="w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 outline-none transition focus:border-amber-400 focus:bg-white focus:ring-4 focus:ring-amber-100" />
        <span asp-validation-for="Unit" class="block text-xs text-rose-600"></span>
    </div>
    <div class="space-y-1.5">
        <label asp-for="Price" class="block text-sm font-bold text-slate-700"></label>
        <input asp-for="Price" type="number" step="0.01" min="0.01" placeholder="Ej.: 48.50" class="w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 outline-none transition focus:border-amber-400 focus:bg-white focus:ring-4 focus:ring-amber-100" />
        <p class="text-xs text-slate-400">Precio de venta por unidad (IVA incluido).</p>
        <span asp-validation-for="Price" class="block text-xs text-rose-600"></span>
    </div>
    <div class="space-y-1.5">
        <label asp-for="Stock" class="block text-sm font-bold text-slate-700"></label>
        <input asp-for="Stock" type="number" min="0" placeholder="Ej.: 120" class="w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 placeholder-slate-400 outline-none transition focus:border-amber-400 focus:bg-white focus:ring-4 focus:ring-amber-100" />
        <span asp-validation-for="Stock" class="block text-xs text-rose-600"></span>
    </div>
    <div class="flex items-center justify-between gap-5 rounded-xl bg-slate-50 p-4 sm:col-span-2">
        <div>
            <label asp-for="IsActive" class="block text-sm font-bold text-slate-700"></label>
            <p class="text-xs text-slate-400">Los productos inactivos no aparecen para la venta.</p>
        </div>
        <input asp-for="IsActive" class="h-5 w-5 rounded border-slate-300 text-amber-500 transition focus:ring-2 focus:ring-amber-400" />
    </div>
</div>