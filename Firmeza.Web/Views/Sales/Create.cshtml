@using Firmeza.Web.Presentation.ViewModels.Sales
@model CreateSaleFormViewModel
@{
    ViewData["Title"] = "Nueva Venta";
}

<div class="mx-auto max-w-4xl">
    <a asp-action="Index" class="text-sm font-bold text-amber-600 hover:text-amber-500">← Volver a ventas</a>
    
    <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="text-sm font-black uppercase tracking-[0.2em] text-amber-600">Operación comercial</p>
            <h1 class="mt-1 text-3xl font-black text-slate-950">Registrar Nueva Venta</h1>
            <p class="mt-1 text-slate-500">Selecciona el cliente y los productos. El recibo PDF se generará automáticamente.</p>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mt-6 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-800">
            <div asp-validation-summary="All" class="text-rose-700"></div>
        </div>
    }

    <form asp-action="Create" method="post" id="sale-form" class="mt-8 space-y-8">
        @Html.AntiForgeryToken()

        <!-- Selección de Cliente -->
        <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
            <h2 class="text-base font-black text-slate-950">1. Datos del Cliente</h2>
            <p class="mt-1 text-xs text-slate-500">Selecciona a quién se le emitirá el comprobante de venta.</p>

            <div class="mt-5">
                <label asp-for="CustomerId" class="block text-xs font-bold uppercase tracking-wider text-slate-700">Cliente *</label>
                <select asp-for="CustomerId" class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-amber-400 focus:ring-4 focus:ring-amber-100" required>
                    <option value="">-- Selecciona un cliente --</option>
                    @foreach (var c in Model.Customers)
                    {
                        <option value="@c.Id">@c.DisplayText</option>
                    }
                </select>
                <span asp-validation-for="CustomerId" class="text-xs text-rose-600"></span>
            </div>
        </div>

        <!-- Líneas de Productos -->
        <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-base font-black text-slate-950">2. Productos y Materiales</h2>
                    <p class="mt-1 text-xs text-slate-500">Agrega los ítems que conforman la orden de venta.</p>
                </div>
                <button type="button" id="btn-add-line" class="inline-flex items-center gap-1.5 rounded-xl bg-amber-100 px-4 py-2 text-xs font-bold text-amber-800 transition hover:bg-amber-200">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5"><path d="M12 5v14M5 12h14" /></svg>
                    Agregar producto
                </button>
            </div>

            <div class="mt-6 overflow-x-auto">
                <table class="w-full text-left text-sm" id="lines-table">
                    <thead class="border-b border-slate-100 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
                        <tr>
                            <th class="px-4 py-3">Producto</th>
                            <th class="px-4 py-3 text-center">Disponible</th>
                            <th class="px-4 py-3 text-center">Cantidad</th>
                            <th class="px-4 py-3 text-right">Precio Unitario</th>
                            <th class="px-4 py-3 text-right">Subtotal</th>
                            <th class="px-4 py-3 text-center"></th>
                        </tr>
                    </thead>
                    <tbody id="lines-body" class="divide-y divide-slate-100 font-medium">
                        <!-- Las filas se agregan mediante JS -->
                    </tbody>
                </table>
            </div>

            <div id="no-lines-msg" class="py-10 text-center text-xs text-slate-400">
                Haz clic en "Agregar producto" para comenzar a armar la venta.
            </div>

            <!-- Resumen Financiero -->
            <div class="mt-8 border-t border-slate-100 pt-6">
                <div class="ml-auto max-w-xs space-y-2 text-sm">
                    <div class="flex justify-between text-slate-600">
                        <span>Subtotal (Base):</span>
                        <span id="summary-subtotal" class="font-bold text-slate-900">$0.00</span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span>IVA (19% inc.):</span>
                        <span id="summary-iva" class="font-bold text-slate-900">$0.00</span>
                    </div>
                    <div class="flex justify-between border-t border-slate-200 pt-2 text-base font-black text-slate-950">
                        <span>Total a Pagar:</span>
                        <span id="summary-total" class="text-xl text-amber-600">$0.00</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3">
            <a asp-action="Index" class="rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-sm font-bold text-slate-700 shadow-sm hover:border-slate-400">Cancelar</a>
            <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-slate-950 px-8 py-3.5 text-sm font-bold text-white shadow-lg shadow-slate-200 transition hover:bg-amber-500 hover:text-slate-950">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" /></svg>
                Registrar Venta y Generar Recibo PDF
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const productsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Products));
        const linesBody = document.getElementById("lines-body");
        const noLinesMsg = document.getElementById("no-lines-msg");
        const btnAddLine = document.getElementById("btn-add-line");

        let lineIndex = 0;

        function formatMoney(amount) {
            return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 2 }).format(amount);
        }

        function updateTotals() {
            let total = 0;
            const rows = linesBody.querySelectorAll("tr");
            
            rows.forEach(row => {
                const subtotalCell = row.querySelector(".line-subtotal");
                const qtyInput = row.querySelector(".line-qty");
                const priceInput = row.querySelector(".line-price");
                
                const qty = parseInt(qtyInput?.value) || 0;
                const price = parseFloat(priceInput?.value) || 0;
                const subtotal = qty * price;
                
                if (subtotalCell) subtotalCell.textContent = formatMoney(subtotal);
                total += subtotal;
            });

            const subtotalBase = total / 1.19;
            const iva = total - subtotalBase;

            document.getElementById("summary-subtotal").textContent = formatMoney(subtotalBase);
            document.getElementById("summary-iva").textContent = formatMoney(iva);
            document.getElementById("summary-total").textContent = formatMoney(total);

            if (rows.length === 0) {
                noLinesMsg.style.display = "block";
            } else {
                noLinesMsg.style.display = "none";
            }
        }

        function addLine() {
            const tr = document.createElement("tr");
            tr.className = "hover:bg-amber-50/20";
            
            let optionsHtml = '<option value="">-- Elegir producto --</option>';
            productsData.forEach(p => {
                optionsHtml += `<option value="${p.Id}" data-price="${p.Price}" data-stock="${p.Stock}">[${p.Sku}] ${p.Name} (${p.Stock} ${p.Unit})</option>`;
            });

            tr.innerHTML = `
                <td class="px-4 py-3">
                    <select name="Lines[${lineIndex}].ProductId" class="product-select block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs outline-none focus:border-amber-400" required>
                        ${optionsHtml}
                    </select>
                </td>
                <td class="px-4 py-3 text-center font-mono text-xs text-slate-500 stock-cell">-</td>
                <td class="px-4 py-3 text-center">
                    <input type="number" name="Lines[${lineIndex}].Quantity" value="1" min="1" class="line-qty w-20 rounded-lg border border-slate-300 px-2.5 py-1.5 text-center text-xs outline-none focus:border-amber-400" required />
                </td>
                <td class="px-4 py-3 text-right">
                    <input type="number" step="0.01" name="Lines[${lineIndex}].UnitPrice" value="0" min="0" class="line-price w-28 rounded-lg border border-slate-300 px-2.5 py-1.5 text-right text-xs outline-none focus:border-amber-400" required />
                </td>
                <td class="px-4 py-3 text-right font-bold text-slate-900 line-subtotal">$0.00</td>
                <td class="px-4 py-3 text-center">
                    <button type="button" class="btn-remove-line rounded-lg p-1.5 text-slate-400 transition hover:bg-rose-50 hover:text-rose-600">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M18 6L6 18M6 6l12 12" /></svg>
                    </button>
                </td>
            `;

            const select = tr.querySelector(".product-select");
            const priceInput = tr.querySelector(".line-price");
            const qtyInput = tr.querySelector(".line-qty");
            const stockCell = tr.querySelector(".stock-cell");
            const btnRemove = tr.querySelector(".btn-remove-line");

            select.addEventListener("change", () => {
                const selected = select.options[select.selectedIndex];
                const price = selected.getAttribute("data-price") || 0;
                const stock = selected.getAttribute("data-stock") || "-";
                priceInput.value = price;
                stockCell.textContent = stock;
                if (stock !== "-") qtyInput.max = stock;
                updateTotals();
            });

            priceInput.addEventListener("input", updateTotals);
            qtyInput.addEventListener("input", updateTotals);

            btnRemove.addEventListener("click", () => {
                tr.remove();
                updateTotals();
            });

            linesBody.appendChild(tr);
            lineIndex++;
            updateTotals();
        }

        btnAddLine.addEventListener("click", addLine);

        // Iniciar con una línea lista
        addLine();
    </script>
}
