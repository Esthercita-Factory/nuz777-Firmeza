@model SaleDetailsViewModel
@{ ViewData["Title"] = "Detalle de venta"; }
<div class="mx-auto max-w-4xl"><a asp-action="Index" class="text-sm font-bold text-amber-600">← Volver a ventas</a><div class="mt-5 flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-black uppercase tracking-[0.2em] text-amber-600">Venta</p><h1 class="mt-2 text-3xl font-black">@Model.SaleNumber</h1><p class="mt-2 text-slate-500">@Model.CustomerName · @Model.SaleDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div><span class="rounded-full bg-emerald-100 px-4 py-2 text-sm font-bold text-emerald-700">@Model.Status</span></div><div class="mt-8 overflow-hidden rounded-2xl bg-white shadow-sm"><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500"><tr><th class="px-6 py-4">Producto</th><th class="px-6 py-4">Código</th><th class="px-6 py-4 text-right">Cantidad</th><th class="px-6 py-4 text-right">Precio</th><th class="px-6 py-4 text-right">Subtotal</th></tr></thead><tbody class="divide-y divide-slate-100">@foreach (var detail in Model.Details) {<tr><td class="px-6 py-4 font-bold">@detail.ProductName</td><td class="px-6 py-4 font-mono text-xs text-slate-500">@detail.ProductSku</td><td class="px-6 py-4 text-right">@detail.Quantity</td><td class="px-6 py-4 text-right">@detail.UnitPrice.ToString("C2")</td><td class="px-6 py-4 text-right font-bold">@detail.Subtotal.ToString("C2")</td></tr>}</tbody><tfoot class="border-t border-slate-200"><tr><td colspan="4" class="px-6 py-5 text-right text-sm font-bold text-slate-500">Total</td><td class="px-6 py-5 text-right text-xl font-black">@Model.Total.ToString("C2")</td></tr></tfoot></table></div></div><div class="mt-5 rounded-2xl bg-white p-6 text-sm text-slate-600 shadow-sm"><span class="font-bold text-slate-900">Documento del cliente:</span> @Model.CustomerDocument</div></div>
