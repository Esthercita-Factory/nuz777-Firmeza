@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="mx-auto max-w-xl rounded-3xl border border-rose-200 bg-white p-10 text-center shadow-sm">
    <p class="text-sm font-black uppercase tracking-widest text-rose-500">Error de aplicación</p>
    <h1 class="mt-3 text-3xl font-black text-slate-950">Algo no salió como esperábamos.</h1>
    <p class="mt-3 text-slate-600">Intenta nuevamente o contacta al administrador del sistema.</p>
    @if (Model.ShowRequestId) { <p class="mt-6 text-xs text-slate-400">Referencia: <code>@Model.RequestId</code></p> }
</div>
