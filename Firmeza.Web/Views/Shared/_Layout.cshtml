@using Firmeza.Web.Infrastructure.Identity
@{
    var displayName = User.Identity?.Name?.Split('@')[0] ?? "";
    var initials = string.Concat(displayName.Take(1)).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Firmeza</title>
    <link rel="stylesheet" href="~/dist/main.css" />
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-100 via-slate-50 to-amber-50 text-slate-900 antialiased">
    @if (User.IsInRole(ApplicationRoles.Administrator))
    {
        <aside id="sidebar" class="fixed inset-y-0 left-0 z-20 hidden w-72 -translate-x-full border-r border-white/60 bg-white/40 text-slate-700 shadow-xl shadow-slate-200/60 backdrop-blur-2xl transition-transform duration-300 ease-in-out lg:block">
            <div class="flex h-full flex-col px-5 py-6">
                <a asp-controller="Dashboard" asp-action="Index" class="mb-10 flex items-center gap-3 px-2 text-slate-950">
                    <partial name="_Logo" model="@("h-10 w-10 shrink-0")" />
                    <span><span class="block text-lg font-black tracking-tight">Firmeza</span><span class="text-xs text-slate-500">Panel administrativo</span></span>
                </a>
                <nav class="space-y-1" aria-label="Navegación principal">
                    <a asp-controller="Dashboard" asp-action="Index" class="block rounded-xl px-4 py-3 text-sm font-semibold transition hover:bg-white/70 hover:text-slate-950">Inicio</a>
                    <a asp-controller="Products" asp-action="Index" class="block rounded-xl px-4 py-3 text-sm font-semibold transition hover:bg-white/70 hover:text-slate-950">Productos</a>
                    <a asp-controller="Customers" asp-action="Index" class="block rounded-xl px-4 py-3 text-sm font-semibold transition hover:bg-white/70 hover:text-slate-950">Clientes</a>
                    <a asp-controller="Sales" asp-action="Index" class="block rounded-xl px-4 py-3 text-sm font-semibold transition hover:bg-white/70 hover:text-slate-950">Ventas</a>
                </nav>
                <div class="mt-auto border-t border-white/60 pt-5">
                    <p class="truncate px-4 text-xs text-slate-500">@User.Identity?.Name</p>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                        <button type="submit" class="w-full rounded-xl px-4 py-3 text-left text-sm font-semibold text-slate-600 transition hover:bg-white/70 hover:text-slate-950">Cerrar sesión</button>
                    </form>
                </div>
            </div>
        </aside>
        <button id="sidebar-toggle" type="button" aria-label="Abrir menú lateral" aria-expanded="false" class="fixed left-5 top-1/2 z-30 hidden -translate-y-1/2 items-center justify-center rounded-full bg-slate-950 p-3 text-white shadow-lg shadow-slate-900/40 transition-all duration-300 hover:bg-amber-400 hover:text-slate-950 lg:inline-flex">
            <svg id="toggle-icon-open" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7" /></svg>
            <svg id="toggle-icon-close" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg>
        </button>
    }

    <div id="main-content" class="flex min-h-screen flex-col transition-[padding] duration-300 ease-in-out">
        <header class="sticky top-0 z-10 border-b border-slate-200/80 bg-white/85 backdrop-blur-lg">
            <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-5 lg:px-8">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 lg:hidden">
                    <partial name="_Logo" model="@("h-8 w-8")" />
                    <span class="text-xl font-black tracking-tight text-slate-950">Firmeza<span class="text-amber-500">.</span></span>
                </a>

                <div class="hidden items-center gap-2.5 lg:flex">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-100 text-amber-600">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M3 7v6a2 2 0 0 0 2 2h2l4 4v-4h4a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2Z" /><path d="M22 11a2 2 0 0 1-2 2h-1v4l-4-4h-.1" /></svg>
                    </span>
                    <span class="max-w-[240px] truncate text-sm font-black uppercase tracking-widest text-slate-700">@ViewData["Title"]</span>
                </div>

                <div class="ml-auto flex items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole(ApplicationRoles.Administrator))
                    {
                        <div class="flex items-center gap-3 rounded-full border border-slate-200 bg-white py-1 pl-1 pr-4 shadow-sm transition hover:border-amber-300">
                            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-950 text-xs font-black uppercase text-amber-400">@initials</span>
                            <span class="hidden text-sm font-bold text-slate-700 sm:block">@displayName</span>
                            <span class="hidden rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-amber-700 sm:block">Admin</span>
                        </div>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="hidden items-center gap-1.5 text-sm text-slate-500 sm:inline-flex">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-slate-400"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                            Cuenta de cliente
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm transition hover:border-rose-200 hover:text-rose-600">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                                Salir
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="hidden items-center gap-1.5 text-sm font-bold text-slate-700 transition hover:text-amber-600 sm:inline-flex">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg>
                            Ingresar
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="inline-flex items-center gap-1.5 rounded-xl bg-amber-500 px-4 py-2 text-sm font-bold text-white shadow-sm shadow-amber-200 transition hover:bg-amber-600">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                            Crear cuenta
                        </a>
                    }
                </div>
            </div>
        </header>

        <main class="mx-auto w-full max-w-7xl flex-1 px-5 py-8 lg:px-8">
            @if (TempData["Message"] is string message)
            {
                <div class="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-semibold text-emerald-800">@message</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="mb-6 rounded-2xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm font-semibold text-rose-800">@error</div>
            }
            @RenderBody()
        </main>

        <footer class="border-t border-slate-200 bg-white px-5 py-6 text-center text-xs text-slate-500 lg:px-8">
            Firmeza · Gestión de productos y clientes
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation/dist/additional-methods.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script type="module" src="~/dist/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
